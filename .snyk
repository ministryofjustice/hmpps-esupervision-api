# Project-owned Snyk policy file. The hmpps-gradle-spring-boot warning header has been removed so the plugin
# no longer regenerates this file; check the plugin's generated ignores when upgrading it and merge in any needed here.
#
# Snyk (https://snyk.io) policy file, patches or ignores known vulnerabilities.
version: v1.25.1
# ignores vulnerabilities until expiry date; change duration by modifying expiry date
ignore:
  SNYK-JAVA-ORGGLASSFISHJAXB-20883142:
    - '*':
        reason: >-
          CVE-2026-92877 XXE in jaxb-core XmlFactory; no fixed release yet (fix on master only). Pulled in
          transitively by hibernate-core for its own trusted XML mapping files; this service never unmarshals
          untrusted XML (JSON-only API, no JAXB usage). Remove once a fixed jaxb-runtime is published.
        expires: 2026-11-20T00:00:00.000Z
        created: 2026-10-20T13:00:00.000Z
patch: {}
