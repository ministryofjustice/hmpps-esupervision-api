# NOTE: update the PUT to S3 with the path to your file: e.g. /Users/YOUR.NAME/Desktop/correct.png

### Start offender setup
< {%
    const setupUuid = $random.uuid
    request.variables.set('setupUuid', setupUuid)
%}
POST {{HOST}}/v2/offender_setup
Content-Type: application/json
Authorization: Bearer {{hmpps_auth.token}}

{
  "setupUuid": "{{$uuid}}",
  "practitionerId": "HTTP.CLIENT",
  "crn": "X000001",
  "firstCheckin": "2026-11-28",
  "checkinInterval": "WEEKLY",
  "contactPreference": "EMAIL"
}

> {%
    if (response.status === 200) {
        const offenderUuid = response.body["offenderUuid"]
        client.log(`initiated setup uuid=${offenderUuid}`)
        client.global.set("offender_uuid", offenderUuid)
        client.global.set("setup_uuid", response.body["uuid"])
    }
%}

### [PHOTO API] Get upload location
POST {{HOST_PHOTO_API}}/v1/offenders/by-uuid/{{offender_uuid}}/photo/reference/upload-location?content-type=image/png
Authorization: Bearer {{hmpps_auth.token}}
Content-Type: application/json

{
  "sha256": "NDNjODI4MDk4NTkyYTMyYzk1MDU4ZGRlZWY0MTkzMTZiMzhmNjEzMmM3MDljZDIzMGUyOTM3M2U0MmUxZDM3OQo="
}

> {%
    client.global.set("photo_upload_url", response.body.url)
    client.global.set("photo_upload_content_type", response.body.contentType)
    client.global.set("photo_upload_required_headers", response.body.requiredHeaders)
    Object.entries(response.body.requiredHeaders || {}).forEach(([name, value]) => {
        client.global.headers.set(name, value)
    })
%}

### [PHOTO API] Upload offender's reference image
PUT {{photo_upload_url}}
Content-Type: {{photo_upload_content_type}}

< /Users/YOUR.NAME/Desktop/correct.png

> {%
    client.log("HELLO", client.global.get("photo_upload_required_headers"))
    client.global.headers.set("x-amz-checksum-sha256", null)
%}

### [DEPRECATED] Upload offender's reference image
PUT http://localhost:4566/image-uploads/setup-{{offender_uuid}}
Content-Type: image/png

< /Users/YOUR.NAME/Desktop/correct.png

### Complete offender setup
POST {{HOST}}/v2/offender_setup/{{setup_uuid}}/complete
Authorization: Bearer {{hmpps_auth.token}}